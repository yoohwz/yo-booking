{
  "name": "yoohw/yo-booking",
  "description": "A fresh appointment booking foundation for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "YoBooking\\": "src/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.0"
  },
	"scripts": {
		"lint": "phpcs",
		"security": "phpcs --standard=phpcs-security.xml.dist",
		"lint:php": "find src tests -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l",
    "test:unit": "phpunit -c phpunit.xml.dist",
		"test": [
			"@lint:php",
			"@test:unit",
			"@lint",
			"@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
