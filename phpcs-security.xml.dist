<?xml version="1.0"?>
<ruleset name="Yo Booking Security">
	<description>Whole-plugin release gate for input validation, authorization, nonce handling, redirects, escaping, and prepared SQL.</description>
	<file>yo-booking.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<arg name="extensions" value="php"/>
	<arg name="warning-severity" value="0"/>
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.SafeRedirect"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
	<rule ref="WordPress.WP.Capabilities"/>
	<rule ref="WordPress.DB.PreparedSQL">
		<!-- WordPress has no identifier placeholder; plugin table names only come from Migrator::table_name(). -->
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
	</rule>
</ruleset>
